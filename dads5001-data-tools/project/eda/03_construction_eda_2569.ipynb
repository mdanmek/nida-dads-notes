        ")\n",
        "\n",
        "budget_p99 = (\n",
        "    project_data['budget_million']\n",
        "    .quantile(0.99)\n",
        ")\n",
        "\n",
        "print(\n",
        "    f'99th percentile of budget: '\n",
        "    f'{budget_p99:,.2f} million THB'\n",
        ")"
      ]
