04374964,\n        \"max\": 38.18077443947182,\n        \"num_unique_values\": 10,\n        \"samples\": [\n          29.128389764759966,\n          0.8918952622030678,\n          1.2906622148154328\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"
