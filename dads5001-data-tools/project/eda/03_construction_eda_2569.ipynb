        "    .rename_axis('budget')\n",
        "    .reset_index(name='project_count')\n",
        ")\n",
        "\n",
        "common_budget_values['budget_million'] = (\n",
        "    common_budget_values['budget']\n",
        "    .div(1_000_000)\n",
        ")\n",
        "\n",
        "common_budget_values['project_pct'] = (\n",
        "    common_budget_values['project_count']\n",
        "    .div(len(project_data))\n",
        "    .mul(100)\n",
        ")\n",
        "\n",
        "display(\n",
